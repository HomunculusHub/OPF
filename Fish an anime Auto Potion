-- ปุ่มเปิด/ปิด ระบบหลัก
local MasterBtn = Instance.new("TextButton")
MasterBtn.Size = UDim2.new(1, -16, 0, 28)
MasterBtn.Position = UDim2.new(0, 8, 0, 2)
MasterBtn.BackgroundColor3 = Color3.fromRGB(45, 160, 80)
