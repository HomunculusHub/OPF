-- รายการ Potion ที่เลื่อนได้
local Scroll = Instance.new("ScrollingFrame")
Scroll.Size = UDim2.new(1, -16, 1, -42)
Scroll.Position = UDim2.new(0, 8, 0, 36)
Scroll.BackgroundTransparency = 1
Scroll.ScrollBarThickness = 3
Scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
Scroll.Parent = ContentContainer

local Layout = Instance.new("UIListLayout", Scroll)
Layout.Padding = UDim.new(0, 4)

for name, enabled in pairs(PotionList) do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -6, 0, 24)
    btn.BackgroundColor3 = enabled and Color3.fromRGB(35, 60, 45) or Color3.fromRGB(32, 32, 36)
    btn.Text = (enabled and " [✓] " or " [ ] ") .. name
    btn.TextColor3 = enabled and Color3.fromRGB(90, 255, 130) or Color3.fromRGB(160, 160, 160)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = Scroll
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

    btn.MouseButton1Click:Connect(function()
        PotionList[name] = not PotionList[name]
        local state = PotionList[name]
        btn.Text = (state and " [✓] " or " [ ] ") .. name
        btn.TextColor3 = state and Color3.fromRGB(90, 255, 130) or Color3.fromRGB(160, 160, 160)
        btn.BackgroundColor3 = state and Color3.fromRGB(35, 60, 45) or Color3.fromRGB(32, 32, 36)
    end)
end

-- ระบบจำลองการกดคลิก
local function triggerClick(btn)
    pcall(function()
        if firesignal then
            firesignal(btn.MouseButton1Click)
            firesignal(btn.MouseButton1Down)
            firesignal(btn.Activated)
        end
    end)
end

-- เช็คว่าไอเทมมี Stock หรือไม่
local function isCardInStock(card)
    for _, desc in ipairs(card:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible then
            local text = desc.Text:lower()
            if text:find("no stock") or text:find("sold out") or text:find("x0 left") then
                return false
            end
        end
    end
    
    for _, desc in ipairs(card:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible then
            local text = desc.Text:lower()
            if text:find("left") or text:find("x") then
                return true
            end
        end
    end
    return false
end

-- ตรวจสอบว่าเป็นปุ่มซื้อด้วยเงิน Cash ($) เท่านั้น (ห้ามกดปุ่ม Gem / Robux)
local function isStrictCashButton(btn)
    local buttonName = btn.Name:lower()
    
    if buttonName:find("gem") or buttonName:find("robux") or buttonName:find("diamond") then
        return false
    end

    local textBlob = ""
    if btn:IsA("TextButton") then
        textBlob = textBlob .. " " .. btn.Text:lower()
    end
    
    for _, desc in ipairs(btn:GetDescendants()) do
        if desc:IsA("TextLabel") then
            textBlob = textBlob .. " " .. desc.Text:lower()
        elseif desc:IsA("ImageLabel") then
            local img = desc.Image:lower()
            if img:find("gem") or img:find("robux") or img:find("diamond") then
                return false
            end
        end
    end

    if textBlob:find("gem") or textBlob:find("diamond") or textBlob:find("💎") or textBlob:find("r%$") or textBlob:find("robux") then
        return false
    end

    if textBlob:find("%$") then
        return true
    end

    return false
end

-- หาและกดปุ่ม Cash
local function clickStrictCashButton(container)
    for _, item in ipairs(container:GetDescendants()) do
        if (item:IsA("TextButton") or item:IsA("ImageButton")) and item.Visible then
            if isStrictCashButton(item) then
                triggerClick(item)
                return true
            end
        end
    end
    return false
end

-- ตรวจสอบร้านค้า
local function sweepStore()
    local pGui = localPlayer:FindFirstChild("PlayerGui")
    if not pGui then return end

    for _, gui in ipairs(pGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled and gui.Name ~= "StrictCashPotionBuyerUI" then
            for _, label in ipairs(gui:GetDescendants()) do
                if label:IsA("TextLabel") and label.Visible and label.Text ~= "" then
                    local labelText = label.Text:lower()
                    
                    for potionKey, enabled in pairs(PotionList) do
                        if enabled and labelText:find(potionKey:lower(), 1, true) then
                            local card = label.Parent
                            if card and isCardInStock(card) then
                                if not clickStrictCashButton(card) and card.Parent then
                                    clickStrictCashButton(card.Parent)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

-- Loop การทำงาน
task.spawn(function()
    while task.wait(CheckInterval) do
        if AutoBuyActive then
            pcall(sweepStore)
        end
    end
end)
