-- Strict Cash-Only & Stock-Aware Potion Auto-Buyer (With Minimize Feature)
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local localPlayer = Players.LocalPlayer

-- รายชื่อ Potion ที่ต้องการให้ซื้อ (true = ซื้อ, false = ไม่ซื้อ)
local PotionList = {
    ["Gems Potion"] = true,
    ["Luck Potion"] = true,
    ["Mutation Potion"] = true,
    ["Fast Catch Potion"] = true,
    ["Cooldown Potion"] = false,
    ["Cash Potion"] = false,
    ["Cosmic"] = true,
    ["Secret"] = true,
    ["Fortune"] = true,
}

local AutoBuyActive = true
local CheckInterval = 0.3
local isMinimized = false

-- ลบ UI เก่าออกหากมีการรันซ้ำ
local oldUI = CoreGui:FindFirstChild("StrictCashPotionBuyerUI") or (localPlayer.PlayerGui and localPlayer.PlayerGui:FindFirstChild("StrictCashPotionBuyerUI"))
if oldUI then oldUI:Destroy() end

-- สร้าง UI
