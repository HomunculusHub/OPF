Instance.new("UICorner", MasterBtn).CornerRadius = UDim.new(0, 6)

MasterBtn.MouseButton1Click:Connect(function()
    AutoBuyActive = not AutoBuyActive
    MasterBtn.BackgroundColor3 = AutoBuyActive and Color3.fromRGB(45, 160, 80) or Color3.fromRGB(180, 45, 45)
    MasterBtn.Text = AutoBuyActive and "Status: ACTIVE" or "Status: OFF"
